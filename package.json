{
  "name": "ledger-payout-service",
  "version": "0.4.0",
  "private": true,
  "description": "A generic, from-scratch double-entry ledger and payout service — an engineering demonstration, not a real financial service.",
  "type": "module",
  "engines": {
    "node": ">=20.11 <21"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run test/integration",
    "test:concurrency": "vitest run test/integration/concurrency.test.ts",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:up": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "migrate:status": "tsx src/db/migrate.ts status",
    "compose:config": "docker compose config -q",
    "audit:prod": "npm audit --omit=dev",
    "audit:dev": "npm audit",
    "scan:proprietary": "node scripts/scan-proprietary.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run compose:config && npm run scan:proprietary"
  },
  "dependencies": {
    "bullmq": "^5.25.6",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "kysely": "^0.28.17",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/node": "^20.17.6",
    "@types/pg": "^8.11.10",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.3.3",
    "testcontainers": "^11.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^3.2.7"
  }
}
