# Copy to .env for local development. DO NOT put real credentials in this file or in .env.
# .env is gitignored; .env.example is the committed template with placeholder values only.

# --- Service ---
NODE_ENV=development
LOG_LEVEL=debug
HTTP_HOST=127.0.0.1
HTTP_PORT=3000

# --- PostgreSQL (matches docker-compose.yml local services) ---
# Local dev only. These are throwaway values for a container that is not exposed publicly.
# DATABASE_URL, if set, takes precedence over the PG* parts below.
# DATABASE_URL=postgres://ledger:change-me-locally@127.0.0.1:5432/ledger
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=ledger
PGUSER=ledger
PGPASSWORD=change-me-locally
# Max pooled connections, and how long a caller waits to borrow one under load.
DB_POOL_MAX=15
DB_CONNECTION_TIMEOUT_MS=10000

# --- Redis (matches docker-compose.yml local services) ---
# Reserved for later milestones (cache, BullMQ). Not on the M2 ledger/transfer path.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Readiness ---
# Milliseconds allowed for each dependency check in /readyz.
READINESS_TIMEOUT_MS=1500

# --- Transfers ---
# Retries on a transient DB error (serialization failure / deadlock) before giving up.
TRANSFER_MAX_RETRIES=3

# --- Funding (dev/test only) ---
# The funding endpoint gives an account an opening balance via a balanced ledger
# transaction (credit target / debit the internal system account). Set to `false` in any
# real deployment — a real ledger has no endpoint that creates money.
ALLOW_FUNDING=true
