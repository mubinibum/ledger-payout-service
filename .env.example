# Copy to .env for local development. DO NOT put real credentials in this file or in .env.
# .env is gitignored; .env.example is the committed template with placeholder values only.

# --- Service ---
NODE_ENV=development
LOG_LEVEL=debug
HTTP_HOST=127.0.0.1
HTTP_PORT=3000

# --- PostgreSQL (matches docker-compose.yml local services) ---
# Local dev only. These are throwaway values for a container that is not exposed publicly.
# DATABASE_URL, if set, takes precedence over the PG* parts below.
# DATABASE_URL=postgres://ledger:change-me-locally@127.0.0.1:5432/ledger
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=ledger
PGUSER=ledger
PGPASSWORD=change-me-locally
# Max pooled connections, and how long a caller waits to borrow one under load.
DB_POOL_MAX=15
DB_CONNECTION_TIMEOUT_MS=10000

# --- Redis (BullMQ queue for the payout worker; also cache in later milestones) ---
# REDIS_URL, if set, takes precedence over REDIS_HOST/REDIS_PORT.
# REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Readiness ---
# Milliseconds allowed for each dependency check in /readyz.
READINESS_TIMEOUT_MS=1500

# --- Transfers ---
# Retries on a transient DB error (serialization failure / deadlock) before giving up.
TRANSFER_MAX_RETRIES=3

# --- Funding (LOCAL DEVELOPMENT / DEMO ONLY) ---
# The funding endpoint gives an account an opening balance via a balanced ledger
# transaction (credit target / debit the internal system account). It is DISABLED by
# default and must never be enabled in a real deployment — a real ledger has no endpoint
# that creates money. Uncomment the next line only for local dev or a demo.
# ALLOW_FUNDING=true

# --- Payout worker (M3) ---
PAYOUT_QUEUE_NAME=payout-jobs
WORKER_CONCURRENCY=5
WORKER_MAX_ATTEMPTS=5
WORKER_BACKOFF_MS=2000

# --- Transactional outbox (M3) ---
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10

# --- Payout provider (M3) ---
# `mock` is the only adapter in M3. PROVIDER_BASE_URL points at the local mock provider.
PAYOUT_PROVIDER=mock
PROVIDER_BASE_URL=http://127.0.0.1:4000
PROVIDER_TIMEOUT_MS=3000

# --- Inbound provider webhook (M3) ---
# No default secret: the webhook endpoint returns 503 until this is set. Use a long random
# value locally; it is shared with the mock provider so it can sign test webhooks.
# WEBHOOK_SECRET=replace-with-a-long-random-local-value
WEBHOOK_TOLERANCE_SEC=300

# --- Reconciliation (M3) ---
RECONCILE_STALE_AFTER_SEC=120
RECONCILE_BATCH_SIZE=50
RECONCILE_MAX_ATTEMPTS=20

# --- Mock provider process (LOCAL ONLY) ---
MOCK_PROVIDER_PORT=4000
MOCK_PROVIDER_WEBHOOK_URL=http://127.0.0.1:3000/v1/webhooks/provider/payouts
