# Copy to .env for local development. DO NOT put real credentials in this file or in .env.
# .env is gitignored; .env.example is the committed template with placeholder values only.

# --- Service ---
NODE_ENV=development
LOG_LEVEL=debug
HTTP_HOST=127.0.0.1
HTTP_PORT=3000

# --- PostgreSQL (matches docker-compose.yml local services) ---
# Local dev only. These are throwaway values for a container that is not exposed publicly.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=ledger
PGUSER=ledger
PGPASSWORD=change-me-locally

# --- Redis (matches docker-compose.yml local services) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Readiness ---
# Milliseconds allowed for each dependency check in /readyz.
READINESS_TIMEOUT_MS=1500
